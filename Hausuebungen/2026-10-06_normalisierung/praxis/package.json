{
  "name": "km5-02-normalisierung-praxis",
  "version": "1.0.0",
  "description": "Lauffähiges Node.js + Prisma 7 Scaffold (SQLite) zur HÜ KM5-02 Normalisierung 1NF–3NF",
  "main": "src/queries.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node src/seed.js",
    "db:reset": "prisma migrate reset --force",
    "run": "node src/queries.js",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "prisma7",
    "normalisierung",
    "sqlite",
    "1nf",
    "2nf",
    "3nf"
  ],
  "author": "Roger Avdiyskiy",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.4",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true
  }
}

